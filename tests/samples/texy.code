<?php

namespace App;

use Texy\Bridges\Latte\TexyMacro;
use Texy\HandlerInvocation;
use Texy\Helpers;
use Texy\HtmlElement;
use Texy\Image;
use Texy\Modifier;
use Texy\Modules\LongWordsModule;
use Texy\Strict;
use Texy\Texy;
use Texy\Utf;


class TexyFactory
{
	public function create(HandlerInvocation $invocation, \Texy\Link $link, string $s): Texy
	{
		$texy = new Texy;
		$texy->setOutputMode(Texy::XHTML1_STRICT);
		$mode = $texy->getOutputMode();
		$texy->encoding = 'windows-1250';
		$texy->styleSheet = 'p {}';
		$texy->xhtml = false;
		Texy::$strictDTD = true;
		Texy::$advertisingNotice = false;
		$texy->cleaner->indent = true;
		$texy->htmlOutputModule->removeOptional = true;
		$texy->linkModule->popupOnClick = '';
		$texy->linkModule->imageOnClick = '';
		$texy->imageModule->onLoad = '';
		$texy->scriptModule->handler = $this;
		$texy->dtd['p'][1]['div'] = 1;
		$classes = $texy->_classes;
		$styles = $texy->_styles;
		HtmlElement::$xhtml = false;
		$revision = Texy::REVISION;
		$texy->linkModule->solveUrlEmail($invocation, $link);
		$texy->htmlOutputModule->postProcess($texy, $s);
		$cite = $texy->blockQuoteModule->citeLink('https://texy.info');
		$html = $texy->process('text');
		$texy->free();
		return $texy;
	}


	public function helpers(Texy $texy, string $s): array
	{
		return [
			Texy::webalize($s),
			Texy::webalize($s, null),
			Helpers::webalize($s, null),
			Texy::freezeSpaces($s),
			Texy::unfreezeSpaces($s),
			Texy::normalize($s),
			Texy::outdent($s),
			Texy::isRelative($s),
			Texy::prependRoot($s, '/'),
			Texy::escapeHtml($s),
			Texy::unescapeHtml($s),
			$texy->blockModule->outdent($s),
			Utf::strtolower($s),
			Utf::utf2ascii($s),
			Utf::toUtf($s, 'cp1250'),
			Utf::utfTo($s, 'cp1250'),
			Utf::utf2html($s, 'cp1250'),
		];
	}


	public function elements(Modifier $modifier, Image $image, HandlerInvocation $invocation): void
	{
		$el = new \TexyHtml('p');
		$text = HtmlElement::INNER_TEXT;
		$transparent = HtmlElement::INNER_TRANSPARENT;
		$mod = new Modifier(mod: '.class');
		$modifier->setProperties(mod: '.class');
		$cite = $modifier->cite;
		$image->overURL = 'over.gif';
		$invocation->free();
		$limit = LongWordsModule::SAFE_LIMIT;
		$dont = LongWordsModule::DONT;
		$html5 = Texy::HTML5;
		$link = new \TexyLink('https://texy.info');
		$config = \TexyConfigurator::class;
	}


	public function latte(\Latte\Engine $latte, Texy $texy): void
	{
		new TexyMacro($latte, $texy);
	}
}


class MyTexy extends Texy
{
	public function __construct()
	{
		parent::__construct();
		$this->setOutputMode(self::HTML5);
		$this->cleaner->indent = false;
		$this->encoding = 'utf-8';
		self::webalize('x');
	}


	public function free(): void
	{
	}
}


class Article
{
	use Strict;

	public string $text = '';
}
