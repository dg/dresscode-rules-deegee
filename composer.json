{
	"name": "dresscode/rules-deegee",
	"description": "👔 Upgrades code written for older Dibi and Texy to their current API: renamed constants, methods and classes are rewritten, the rest is reported with what to write instead.",
	"keywords": ["dibi", "texy", "database", "markup", "upgrade", "upgrading", "migration", "deprecations", "refactoring", "codemod", "dresscode"],
	"homepage": "https://dresscode.run/upgrading-deegee",
	"license": "MIT",
	"type": "dresscode-plugin",
	"authors": [
		{
			"name": "David Grudl",
			"homepage": "https://davidgrudl.com"
		}
	],
	"require": {
		"php": "8.4 - 8.6",
		"dresscode/dresscode": "dev-master"
	},
	"require-dev": {
		"dibi/dibi": "^5.1",
		"nette/di": "^3.2",
		"nette/phpstan-rules": "^1.0",
		"nette/tester": "^2.6",
		"phpstan/extension-installer": "^1.4",
		"phpstan/phpstan": "^2.2",
		"texy/texy": "^3.2"
	},
	"minimum-stability": "dev",
	"prefer-stable": true,
	"scripts": {
		"phpstan": "phpstan analyse",
		"tester": "tester tests -s"
	},
	"config": {
		"allow-plugins": {
			"phpstan/extension-installer": true
		}
	},
	"extra": {
		"branch-alias": {
			"dev-master": "1.0-dev"
		},
		"dresscode": {
			"upgrading": [
				"upgrading/dibi.neon",
				"upgrading/texy.neon"
			]
		}
	}
}
