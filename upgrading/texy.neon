package: texy/texy
group: deprecations

since 3.2.8:
	replaced-members:
		Texy\Texy::unProtect: unprotect
	forbidden-members:
		Texy\Texy::HTML4_TRANSITIONAL: 'there is no replacement, the output is always HTML5'
		Texy\Texy::HTML4_STRICT: 'there is no replacement, the output is always HTML5'
		Texy\Texy::HTML5: 'there is no replacement, the output is always HTML5'
		Texy\Texy::XHTML1_TRANSITIONAL: 'there is no replacement, XHTML is not generated any more and the output is always HTML5'
		Texy\Texy::XHTML1_STRICT: 'there is no replacement, XHTML is not generated any more and the output is always HTML5'
		Texy\Texy::XHTML5: 'there is no replacement, XHTML is not generated any more and the output is always HTML5'
		Texy\Texy::XML: 'there is no replacement, XHTML is not generated any more and the output is always HTML5'

since 3.2.6:
	forbidden-classes:
		Texy\Bridges\Latte\TexyMacro: 'support for Latte 2 is gone; register `new Texy\Bridges\Latte\TexyExtension($texy)` with `Latte\Engine::addExtension()`'

since 3.2.3:
	forbidden-members:
		Texy\Modules\HtmlOutputModule::$removeOptional: 'optional end tags are never removed; drop the setting'

since 3.2:
	forbidden-classes:
		Texy\Strict: 'there is no replacement, the trait is gone; undefined members follow plain PHP semantics'
	forbidden-members:
		Texy\Modifier::$cite: 'there is no replacement, support for the `cite` attribute is gone'
		Texy\Modules\BlockQuoteModule::citeLink: 'there is no replacement, support for the `cite` attribute is gone'
		Texy\Modules\BlockModule::solve: 'the method is private; customize the output with a handler registered by `Texy\Texy::addHandler()`'
		Texy\Modules\BlockModule::beforeBlockParse: 'the method is private; customize the output with a handler registered by `Texy\Texy::addHandler()`'
